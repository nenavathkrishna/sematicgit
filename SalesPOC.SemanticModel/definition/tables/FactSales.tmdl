table FactSales
	lineageTag: ea722b40-08d4-4c75-9a61-53c6f2d36d2a

	measure 'Avg Sale' = AVERAGE(FactSales[Amount])
		formatString: \$#,##0
		lineageTag: a9e51d0e-8528-4ef9-8a95-0cfb15be4962

	measure 'Sales YTD' = TOTALYTD([Total Sales], DimDate[Date])
		formatString: \$#,##0
		lineageTag: 92742e95-f49b-4cd1-9f3d-51d2ec3ec9cd

	measure 'Total Margin' = SUMX(FactSales, FactSales[Amount] * 0.3)
		formatString: \$#,##0
		lineageTag: 3b71a479-5548-4f70-82ea-ac6cca725275

	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 309071f7-9b0d-402e-b35a-1d5193fba3eb
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column ProductID
		dataType: int64
		formatString: 0
		lineageTag: 8ec1e355-29af-4c65-8271-fb02ba71dcad
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = Automatic

	column Amount
		dataType: double
		formatString: \$#,##0
		lineageTag: 8ce76aa2-f750-4994-b098-02fc46bb8534
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	partition FactSales = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [Date = date, ProductID = Int64.Type, Amount = number],
				        {
				            {#date(2026,1,1), 1, 100},
				            {#date(2026,1,2), 2, 250},
				            {#date(2026,1,3), 1, 175},
				            {#date(2026,2,1), 3, 300},
				            {#date(2026,2,15), 2, 220},
				            {#date(2026,3,3), 1, 90}
				        }
				    )
				in
				    Source

