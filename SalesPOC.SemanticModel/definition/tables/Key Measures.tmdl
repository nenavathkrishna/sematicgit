table 'Key Measures'
	lineageTag: 3ea9c1d7-0f42-4b6e-9a11-8c7d2e5f4a10

	measure 'Total Sales' = SUM(FactSales[Amount])
		formatString: \$#,##0
		lineageTag: 5b1f8c22-1d34-49a7-9e60-2a7c4b0d9f31

	measure 'Margin %' = DIVIDE([Total Margin], [Total Sales])
